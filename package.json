{
  "name": "corporacion-tejer-paz",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=12.21.0"
  },
  "scripts": {
    "preinstall": "node -e \"if(!/pnpm/.test(process.env.npm_execpath||'')){console.error('Error: Este proyecto usa exclusivamente pnpm (pnpm@12.21.0). No uses npm.');process.exit(1)}\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "admin:bootstrap": "tsx src/db/bootstrap-admin.ts",
    "media:migrate-blob": "tsx src/db/migrate-media-to-blob.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@vercel/blob": "^2.9.0",
    "better-auth": "^1.7.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.70.0",
    "next": "^16.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.35.0",
    "tailwindcss": "^4.3.3",
    "validator": "^13.15.35",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/validator": "^13.15.10",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vercel": "^65.0.0",
    "vitest": "^5.0.0"
  }
}
