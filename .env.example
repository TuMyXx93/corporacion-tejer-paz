# ==============================================================================
# Corporación Tejer Paz — Environment Variables Template
# Copy to .env.local for local development. NEVER commit .env.local or secrets.
# ==============================================================================

# --- App URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Neon Postgres) ---
# Pooled connection string for runtime (Vercel Serverless + Drizzle)
DATABASE_URL=
# Direct (unpooled) connection string for drizzle-kit migrations
DATABASE_URL_UNPOOLED=

# --- Authentication (Better Auth) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Initial Superadmin Bootstrap (used ONLY by `pnpm run admin:bootstrap`) ---
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_NAME="Superadministrador Tejer Paz"

# --- Storage Provider ("vercel-blob" for Vercel demo | "r2" for Cloudflare R2) ---
STORAGE_PROVIDER=vercel-blob
BLOB_READ_WRITE_TOKEN=

# Optional future Cloudflare R2 credentials (when STORAGE_PROVIDER=r2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# --- Contact Email (Resend) ---
# Note: Without a verified custom domain, Resend only allows sending from
# onboarding@resend.dev to the exact email owning the Resend account.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=coorp.tejerpaz@gmail.com
